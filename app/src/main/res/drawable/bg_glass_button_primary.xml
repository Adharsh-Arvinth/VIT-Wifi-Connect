<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/accent_subtle">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_button" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <layer-list>
            <!-- Outer soft glow -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_button" />
                    <solid android:color="@color/glass_glow" />
                </shape>
            </item>
            <!-- Button Body -->
            <item
                android:top="1dp"
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_button" />
                    <solid android:color="@color/accent_primary" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/glass_specular_top" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
