<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/widget_padding"
    android:paddingVertical="@dimen/space_12">

    <!-- Status Information Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_title"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/space_4">

            <ImageView
                android:id="@+id/widget_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/status_dot_disconnected"
                android:contentDescription="Status" />

            <TextView
                android:id="@+id/widget_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:text="@string/status_disconnected"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </LinearLayout>

    <!-- One-Tap Action Button -->
    <Button
        android:id="@+id/widget_connect_button"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="@string/action_connect"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_on_primary"
        android:background="@drawable/widget_button_bg"
        android:paddingHorizontal="@dimen/space_16"
        android:minWidth="0dp"
        android:minHeight="0dp" />

</LinearLayout>
