<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingTop="@dimen/space_24"
        android:paddingBottom="@dimen/space_32">

        <!-- Header: Back Button & Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_20">

            <ImageButton
                android:id="@+id/btn_settings_back"
                style="@style/VitIconButtonGlass"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary"
                android:contentDescription="@string/action_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:text="@string/title_settings"
                style="@style/TextAppearance.Vit.Title" />
        </LinearLayout>

        <!-- SECTION 1: ACCOUNT & SESSION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_account"
            style="@style/TextAppearance.Vit.Section"
            android:layout_marginBottom="@dimen/space_8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:layout_marginBottom="@dimen/space_24">

            <!-- Auto-login on Connect -->
            <LinearLayout
                android:id="@+id/row_auto_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_auto_login"
                        style="@style/TextAppearance.Vit.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pref_auto_login_summary"
                        style="@style/TextAppearance.Vit.Subhead" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_settings_auto_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/AppTheme" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:layout_marginStart="@dimen/space_16"
                android:background="@color/surface_border" />

            <!-- Zero-Drain Mode (No Background) -->
            <LinearLayout
                android:id="@+id/row_no_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_no_background"
                        style="@style/TextAppearance.Vit.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pref_no_background_summary"
                        style="@style/TextAppearance.Vit.Subhead" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_no_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/AppTheme" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:layout_marginStart="@dimen/space_16"
                android:background="@color/surface_border" />

            <!-- Session Logout -->
            <LinearLayout
                android:id="@+id/row_session_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_session_logout"
                        style="@style/TextAppearance.Vit.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pref_session_logout_summary"
                        style="@style/TextAppearance.Vit.Subhead" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_medium"
                    android:layout_height="@dimen/icon_medium"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_muted"
                    android:contentDescription="Logout" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:layout_marginStart="@dimen/space_16"
                android:background="@color/surface_border" />

            <!-- Update Credentials -->
            <LinearLayout
                android:id="@+id/row_update_credentials"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_update_credentials"
                        style="@style/TextAppearance.Vit.Body" />

                    <TextView
                        android:id="@+id/tv_credentials_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pref_update_credentials_summary"
                        style="@style/TextAppearance.Vit.Subhead" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_medium"
                    android:layout_height="@dimen/icon_medium"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_muted"
                    android:contentDescription="Next" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:layout_marginStart="@dimen/space_16"
                android:background="@color/surface_border" />

            <!-- Clear Credentials -->
            <LinearLayout
                android:id="@+id/row_clear_credentials"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_clear_credentials"
                        style="@style/TextAppearance.Vit.Body"
                        android:textColor="@color/status_error" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pref_clear_credentials_summary"
                        style="@style/TextAppearance.Vit.Subhead" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_medium"
                    android:layout_height="@dimen/icon_medium"
                    android:src="@drawable/ic_trash"
                    app:tint="@color/status_error"
                    android:contentDescription="Clear" />
            </LinearLayout>

        </LinearLayout>

        <!-- SECTION 2: APPEARANCE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_appearance"
            style="@style/TextAppearance.Vit.Section"
            android:layout_marginBottom="@dimen/space_8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:layout_marginBottom="@dimen/space_24">

            <!-- Theme: System Default -->
            <LinearLayout
                android:id="@+id/row_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_theme"
                        style="@style/TextAppearance.Vit.Body" />

                    <TextView
                        android:id="@+id/tv_theme_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pref_theme_summary"
                        style="@style/TextAppearance.Vit.Subhead" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_medium"
                    android:layout_height="@dimen/icon_medium"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_muted"
                    android:contentDescription="Select" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:layout_marginStart="@dimen/space_16"
                android:background="@color/surface_border" />

            <!-- Color Palette -->
            <LinearLayout
                android:id="@+id/row_accent_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_accent_color"
                        style="@style/TextAppearance.Vit.Body" />

                    <TextView
                        android:id="@+id/tv_accent_color_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pref_accent_color_summary"
                        style="@style/TextAppearance.Vit.Subhead" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_medium"
                    android:layout_height="@dimen/icon_medium"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_muted"
                    android:contentDescription="Select" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:layout_marginStart="@dimen/space_16"
                android:background="@color/surface_border" />

            <!-- Dynamic Colors: Material You -->
            <LinearLayout
                android:id="@+id/row_dynamic_colors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_dynamic_colors"
                        style="@style/TextAppearance.Vit.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pref_dynamic_colors_summary"
                        style="@style/TextAppearance.Vit.Subhead" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_dynamic_colors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/AppTheme" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:layout_marginStart="@dimen/space_16"
                android:background="@color/surface_border" />

            <!-- Chart Bar Colors: Material Dynamic -->
            <LinearLayout
                android:id="@+id/row_chart_colors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_chart_colors"
                        style="@style/TextAppearance.Vit.Body" />

                    <TextView
                        android:id="@+id/tv_chart_colors_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pref_chart_colors_summary"
                        style="@style/TextAppearance.Vit.Subhead" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_medium"
                    android:layout_height="@dimen/icon_medium"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_muted"
                    android:contentDescription="Select" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:layout_marginStart="@dimen/space_16"
                android:background="@color/surface_border" />

            <!-- Haptic Feedback -->
            <LinearLayout
                android:id="@+id/row_haptic_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_haptic_feedback"
                        style="@style/TextAppearance.Vit.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pref_haptic_summary"
                        style="@style/TextAppearance.Vit.Subhead" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_haptic_feedback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/AppTheme" />
            </LinearLayout>

        </LinearLayout>

        <!-- SECTION 3: CAMPUS WI-FI STABILITY -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_campus_guide"
            style="@style/TextAppearance.Vit.Section"
            android:layout_marginBottom="@dimen/space_8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:layout_marginBottom="@dimen/space_24">

            <!-- MAC Randomization Guide -->
            <LinearLayout
                android:id="@+id/row_mac_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/icon_medium"
                    android:layout_height="@dimen/icon_medium"
                    android:src="@drawable/ic_bolt"
                    app:tint="@color/status_connected"
                    android:contentDescription="Stability" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/space_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_mac_guide"
                        style="@style/TextAppearance.Vit.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pref_mac_guide_summary"
                        style="@style/TextAppearance.Vit.Subhead" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_medium"
                    android:layout_height="@dimen/icon_medium"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_muted"
                    android:contentDescription="View" />
            </LinearLayout>

        </LinearLayout>

        <!-- SECTION 4: DATA MANAGEMENT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_data"
            style="@style/TextAppearance.Vit.Section"
            android:layout_marginBottom="@dimen/space_8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface">

            <!-- Speed Units -->
            <LinearLayout
                android:id="@+id/row_speed_units"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_speed_units"
                        style="@style/TextAppearance.Vit.Body" />

                    <TextView
                        android:id="@+id/tv_speed_units_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pref_speed_units_summary"
                        style="@style/TextAppearance.Vit.Subhead" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_medium"
                    android:layout_height="@dimen/icon_medium"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_muted"
                    android:contentDescription="Select" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:layout_marginStart="@dimen/space_16"
                android:background="@color/surface_border" />

            <!-- Clear Stats -->
            <LinearLayout
                android:id="@+id/row_clear_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_clear_stats"
                        style="@style/TextAppearance.Vit.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pref_clear_stats_summary"
                        style="@style/TextAppearance.Vit.Subhead" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_medium"
                    android:layout_height="@dimen/icon_medium"
                    android:src="@drawable/ic_trash"
                    app:tint="@color/text_secondary"
                    android:contentDescription="Reset" />
            </LinearLayout>

        </LinearLayout>

        <!-- SECTION 5: SYSTEM INTEGRATIONS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_integrations"
            style="@style/TextAppearance.Vit.Section"
            android:layout_marginTop="@dimen/space_24"
            android:layout_marginBottom="@dimen/space_8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface">

            <!-- Control Center Tile -->
            <LinearLayout
                android:id="@+id/row_tile_shortcut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/icon_medium"
                    android:layout_height="@dimen/icon_medium"
                    android:src="@drawable/ic_bolt"
                    app:tint="@color/text_primary"
                    android:contentDescription="Tile" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/space_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_tile_shortcut"
                        style="@style/TextAppearance.Vit.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pref_tile_summary"
                        style="@style/TextAppearance.Vit.Subhead" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_medium"
                    android:layout_height="@dimen/icon_medium"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_muted"
                    android:contentDescription="Add" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_thin"
                android:layout_marginStart="@dimen/space_16"
                android:background="@color/surface_border" />

            <!-- Home Screen Widget -->
            <LinearLayout
                android:id="@+id/row_widget_shortcut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/icon_medium"
                    android:layout_height="@dimen/icon_medium"
                    android:src="@drawable/ic_widget"
                    app:tint="@color/text_primary"
                    android:contentDescription="Widget" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/space_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_widget_shortcut"
                        style="@style/TextAppearance.Vit.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pref_widget_summary"
                        style="@style/TextAppearance.Vit.Subhead" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_medium"
                    android:layout_height="@dimen/icon_medium"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_muted"
                    android:contentDescription="Add" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
