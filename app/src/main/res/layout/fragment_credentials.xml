<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingTop="@dimen/space_24"
        android:paddingBottom="@dimen/space_32">

        <!-- Header: Back & Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_20">

            <ImageButton
                android:id="@+id/btn_credentials_back"
                style="@style/VitIconButtonGlass"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary"
                android:contentDescription="@string/action_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:text="@string/title_credentials"
                style="@style/TextAppearance.Vit.Title" />
        </LinearLayout>

        <!-- Subtitle & Keystore Security Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_credentials"
            style="@style/TextAppearance.Vit.Subhead"
            android:layout_marginBottom="@dimen/space_24" />

        <!-- Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:padding="@dimen/space_20"
            android:layout_marginBottom="@dimen/space_24">

            <!-- Registration Number Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/cred_reg_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_reg_number"
                android:layout_marginBottom="@dimen/space_16"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="@dimen/radius_medium"
                app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                app:boxStrokeColor="@color/surface_border"
                app:boxStrokeWidth="@dimen/stroke_thin"
                app:boxBackgroundColor="@color/surface_subsurface">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/cred_reg_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:paddingVertical="@dimen/space_16"
                    android:paddingHorizontal="@dimen/space_16" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/cred_pass_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_password"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="@dimen/radius_medium"
                app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                app:boxStrokeColor="@color/surface_border"
                app:boxStrokeWidth="@dimen/stroke_thin"
                app:boxBackgroundColor="@color/surface_subsurface"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/cred_pass_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:paddingVertical="@dimen/space_16"
                    android:paddingHorizontal="@dimen/space_16" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Real-time Error Text -->
            <TextView
                android:id="@+id/cred_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textColor="@color/status_error"
                style="@style/TextAppearance.Vit.Caption"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_credentials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_save_credentials"
            style="@style/VitButtonPrimary" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
