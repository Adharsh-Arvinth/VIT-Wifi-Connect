<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base DayNight Theme with Quiet Chrome -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/surface_background</item>
        <item name="android:statusBarColor">@color/surface_background</item>
        <item name="android:navigationBarColor">@color/surface_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="AppTheme.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/surface_background</item>
        <item name="android:statusBarColor">@color/surface_background</item>
        <item name="android:navigationBarColor">@color/surface_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Base Typography Style -->
    <style name="TextAppearance.Vit" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Typography Scale -->
    <style name="TextAppearance.Vit.Display" parent="TextAppearance.Vit">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Vit.Title" parent="TextAppearance.Vit">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Vit.Section" parent="TextAppearance.Vit">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Vit.Body" parent="TextAppearance.Vit">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Vit.Subhead" parent="TextAppearance.Vit">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Vit.Caption" parent="TextAppearance.Vit">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.Vit.Mono" parent="TextAppearance.Vit">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Button Component Variants -->
    <style name="VitButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent_primary</item>
        <item name="strokeColor">@color/glass_specular_top</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@animator/apple_button_press</item>
    </style>

    <style name="VitButtonSecondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/surface_subsurface</item>
        <item name="strokeColor">@color/surface_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@animator/apple_button_press</item>
    </style>

    <!-- Apple Music Glass Circle Icon Button -->
    <style name="VitIconButtonGlass">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/bg_glass_circle_button</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:stateListAnimator">@animator/apple_button_press</item>
    </style>

    <!-- Dialog Style -->
    <style name="VitDialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:background">@color/surface_card</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>
</resources>
