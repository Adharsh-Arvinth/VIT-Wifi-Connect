    <!-- Campus Network Guide -->
    <string name="section_campus_guide">Campus Wi-Fi Stability</string>
    <string name="pref_mac_guide">Disable MAC Randomization</string>
    <string name="pref_mac_guide_summary">Prevents campus Wi-Fi from disconnecting every few minutes</string>
    <string name="dialog_mac_guide_title">Prevent Wi-Fi Disconnects</string>
    <string name="dialog_mac_guide_message">VIT campus routers track active connections by your device\'s hardware MAC address.\n\nModern phones enable \"Randomized MAC\" by default, which changes your MAC periodically and kicks you off the network!\n\nTo fix:\n1. Open Android Settings &gt; Network &amp; internet &gt; Wi-Fi.\n2. Tap the gear/settings icon next to your connected VIT Wi-Fi (e.g. F-VIT).\n3. Tap Privacy.\n4. Change from \"Use randomized MAC\" to \"Use device MAC\".\n\nYour connection will now remain stable without unexpected disconnects!</string>

